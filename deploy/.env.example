# Copy to deploy/.env on the VM and fill in. Never commit the real file.

# Your Groq key, from https://console.groq.com/keys
GROQ_API_KEY=

# Generate ONCE and never change it: rotating this invalidates every visitor
# cookie at the same moment.
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# The hostname Caddy will request a certificate for, e.g. ai-job-eval.duckdns.org
SITE_DOMAIN=

# Used by Let's Encrypt for expiry warnings.
ACME_EMAIL=
