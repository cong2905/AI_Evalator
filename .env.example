# Copy to server/.env and fill in your key from https://console.groq.com/keys
# Never import these into the client.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3001

# Signs the anonymous visitor session cookie. Generate one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# Where the data lives. Leave both blank for local development and the app uses
# server/data/app.db on disk.
#
# Set them to put the database on Turso (hosted libSQL) instead, which is what
# lets the app run on a host whose filesystem is wiped on every restart — the
# whole point of the Render free tier. Get both from `turso db show` and
# `turso db tokens create`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
